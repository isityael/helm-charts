{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "enabled",
    "image",
    "postgres",
    "worker",
    "networkPolicy",
    "auth",
    "browser"
  ],
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "image": {
      "type": "object",
      "required": [
        "spec"
      ],
      "properties": {
        "spec": {
          "type": "string"
        }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "sourceConcurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "sourceIntervalSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "sourceHosts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*\\.[a-z]{2,}$"
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "required": [
        "existingSecret"
      ],
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "apiIntegration",
        "image",
        "publicOrigin",
        "persistence",
        "egressHosts",
        "resources",
        "proxyResources"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "apiIntegration": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "pattern": "^selenium/standalone-firefox@sha256:[a-f0-9]{64}$"
        },
        "publicOrigin": {
          "type": "string"
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "storageClass",
            "size"
          ],
          "properties": {
            "storageClass": {
              "type": "string"
            },
            "size": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(Mi|Gi)$"
            }
          }
        },
        "egressHosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*\\.[a-z]{2,}$"
          }
        },
        "resources": {
          "type": "object"
        },
        "proxyResources": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "apiIntegration": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "enabled": {
                "const": true
              },
              "publicOrigin": {
                "pattern": "^https://[a-z0-9.-]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "persistence": {
                "properties": {
                  "storageClass": {
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "auth": {
            "properties": {
              "existingSecret": {
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
